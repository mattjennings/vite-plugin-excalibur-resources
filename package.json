{
  "name": "vite-plugin-excalibur-resources",
  "version": "0.6.0",
  "type": "module",
  "main": "./src/index.js",
  "workspaces": [
    ".",
    "./example"
  ],
  "bin": {
    "excalibur-resources": "./bin/excalibur-resources.js"
  },
  "exports": {
    "./loaders/aseprite": {
      "import": "./src/loaders/aseprite.js",
      "types": "./src/loaders/aseprite.d.ts"
    },
    "./loaders/tiled": {
      "import": "./src/loaders/tiled.js",
      "types": "./src/loaders/tiled.d.ts"
    },
    "./loaders/ldtk": {
      "import": "./src/loaders/ldtk.js",
      "types": "./src/loaders/ldtk.d.ts"
    },
    "./loaders": {
      "import": "./src/loaders.js"
    },
    "./types": {
      "types": "./src/types.d.ts"
    },
    "./runtime": {
      "import": "./src/runtime.js"
    },
    ".": "./src/index.js"
  },
  "typesVersions": {
    "*": {
      "runtime": [
        "src/runtime.d.ts"
      ],
      "types": [
        "src/types.d.ts"
      ],
      "resources": [
        "src/resources.d.ts"
      ],
      "loaders/aseprite": [
        "src/loaders/aseprite.d.ts"
      ],
      "loaders/tiled": [
        "src/loaders/tiled.d.ts"
      ],
      "loaders/ldtk": [
        "src/loaders/ldtk.d.ts"
      ]
    }
  },
  "scripts": {
    "test": "vitest --config tests/vite.config.js",
    "prepublishOnly": "npm run test -- run"
  },
  "peerDependencies": {
    "excalibur": "0.x"
  },
  "optionalDependencies": {
    "@excaliburjs/plugin-aseprite": "^0.30.0",
    "@excaliburjs/plugin-ldtk": "^0.30.0",
    "@excaliburjs/plugin-tiled": "^0.30.0"
  },
  "devDependencies": {
    "excalibur": "^0.30.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@babel/parser": "^7.20.7",
    "dedent": "^1.7.0",
    "fast-glob": "^3.2.12",
    "query-string": "^9.3.1",
    "recast": "^0.23.11"
  }
}
